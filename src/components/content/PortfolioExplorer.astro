---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import PortfolioMap from "@/components/content/PortfolioMap.astro";
import type { PortfolioAsset, PortfolioLocation } from "@/data/portfolio.ts";
import { CONTACT_EMAIL } from "@/consts.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Assets listed in the tabs, in order. */
  assets?: PortfolioAsset[];
  /** Pins on the map. */
  locations?: PortfolioLocation[];
  /** Summary beside the map label. */
  mapSummary?: string;
  /** Note beside the map legend. */
  mapNote?: string;
  /** Link label under each asset. */
  linkLabel?: string;
};

const {
  render = true,
  assets = [],
  locations = [],
  mapSummary,
  mapNote,
  linkLabel = "Discuss this asset",
  class: className,
  ...rest
} = Astro.props;

const first = assets[0];
const mailto = (name: string) =>
  `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`NTP portfolio | ${name}`)}`;
const tabIndex = (index: number) => String(index + 1).padStart(2, "0");
---

{
  render && first && (
    <div class:list={["portfolio-explorer_wrap", className]} {...rest}>
      <div class="portfolio-explorer_map">
        <PortfolioMap
          locations={locations}
          assets={assets}
          active={first.location}
          summary={mapSummary}
          note={mapNote}
        />
      </div>

      <div class="portfolio-explorer_panel">
        <div
          class="portfolio-explorer_tabs"
          role="tablist"
          aria-label="Portfolio assets"
        >
          {assets.map((asset, index) => (
            <button
              class="portfolio-explorer_tab"
              type="button"
              id={`asset-tab-${asset.id}`}
              role="tab"
              aria-label={asset.name}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`asset-panel-${asset.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-location={asset.location}
            >
              {tabIndex(index)}
            </button>
          ))}
        </div>
        {assets.map((asset, index) => (
          <div
            class="portfolio-explorer_detail"
            id={`asset-panel-${asset.id}`}
            role="tabpanel"
            tabindex="0"
            aria-labelledby={`asset-tab-${asset.id}`}
            hidden={index !== 0}
          >
            <p class="portfolio-explorer_region">{asset.region}</p>
            <Heading tag="h3">{asset.name}</Heading>
            <p class="portfolio-explorer_description">{asset.description}</p>
            <dl class="portfolio-explorer_metrics">
              <div>
                <dt>Power</dt>
                <dd>
                  {asset.power}
                  <span>MW</span>
                </dd>
              </div>
              <div>
                <dt>Capacity</dt>
                <dd>
                  {asset.capacity}
                  <span>MWh</span>
                </dd>
              </div>
            </dl>
            <p
              class:list={[
                "portfolio-explorer_status",
                asset.operational && "is-operational",
              ]}
            >
              {asset.status}
            </p>
            <p class="portfolio-explorer_status-note">{asset.statusNote}</p>
            <div class="portfolio-explorer_equipment">
              <Eyebrow tag="span">Power conversion</Eyebrow>
              <p>{asset.equipment}</p>
            </div>
            <ButtonWrapper marginTop="4">
              <Button
                element="link"
                variant="link"
                href={mailto(asset.name)}
                trail="↗"
                class="width-full"
              >
                {linkLabel}
              </Button>
            </ButtonWrapper>
          </div>
        ))}
      </div>
    </div>
  )
}

<script>
  for (const explorer of document.querySelectorAll<HTMLElement>(
    ".portfolio-explorer_wrap",
  )) {
    const tabs = [
      ...explorer.querySelectorAll<HTMLButtonElement>(
        ".portfolio-explorer_tab",
      ),
    ];
    const pins = [
      ...explorer.querySelectorAll<HTMLButtonElement>(".portfolio-map_pin"),
    ];

    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const other of tabs) {
        const active = other === tab;
        other.setAttribute("aria-selected", String(active));
        other.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(
          other.getAttribute("aria-controls") ?? "",
        );
        if (!panel) continue;
        panel.hidden = !active;
        if (active) {
          panel.classList.remove("is-entering");
          requestAnimationFrame(() => panel.classList.add("is-entering"));
        }
      }
      const tabAt = tabs.indexOf(tab);
      for (const pin of pins) {
        const first = tabs[Number(pin.dataset.tab)];
        const active = first?.dataset.location === tabs[tabAt].dataset.location;
        pin.classList.toggle("is-active", active);
        pin.setAttribute("aria-pressed", String(active));
      }
      if (focus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const next =
          event.key === "ArrowRight"
            ? (index + 1) % tabs.length
            : event.key === "ArrowLeft"
              ? (index - 1 + tabs.length) % tabs.length
              : event.key === "Home"
                ? 0
                : event.key === "End"
                  ? tabs.length - 1
                  : undefined;
        if (next === undefined) return;
        event.preventDefault();
        select(tabs[next], true);
      });
    });

    for (const pin of pins) {
      pin.addEventListener("click", () => {
        const tab = tabs[Number(pin.dataset.tab)];
        if (tab) select(tab);
      });
    }
  }
</script>

<style is:global>
  @layer components {
    .portfolio-explorer_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1.85fr) minmax(21.25rem, 1fr);
      gap: 1.25rem;
      @media (width < 64rem) {
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
      }
    }

    .portfolio-explorer_map {
      display: flex;
      min-width: 0;
      background-color: var(--background-3);
      border-radius: var(--radius-main);
    }

    .portfolio-explorer_panel {
      --link-text: var(--brand-500);
      --link-border: #c6d7c8;
      min-width: 0;
      padding: 1.875rem 2rem;
      background-color: var(--light-100);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      @media (width < 64rem) {
        padding: 2rem;
      }
      @media (width < 30rem) {
        padding: 1.5rem 1.375rem;
      }
    }

    .portfolio-explorer_tabs {
      display: flex;
      gap: 0.5rem;
      padding-bottom: 1.5rem;
      margin-bottom: 1.625rem;
      border-bottom: var(--border-width) solid var(--border);
      @media (width < 30rem) {
        padding-bottom: 1.25rem;
        margin-bottom: 1.375rem;
      }
    }

    .portfolio-explorer_tab {
      width: 2.625rem;
      height: 2.375rem;
      border-radius: 0.375rem;
      background-color: var(--background-2);
      color: var(--text-3);
      font-size: 0.75rem;
      text-align: center;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--brand-100);
          color: var(--brand-500);
        }
      }
      &[aria-selected="true"] {
        background-color: var(--brand-500);
        color: var(--light-100);
      }
      @media (width < 30rem) {
        width: 2.5rem;
      }
    }

    .portfolio-explorer_detail {
      & p {
        text-box: none;
      }
      &.is-entering {
        animation: portfolio-explorer-in 0.25s ease both;
      }
    }

    @keyframes portfolio-explorer-in {
      from {
        opacity: 0.5;
        transform: translateY(0.25rem);
      }
    }

    .portfolio-explorer_region {
      font-size: 0.625rem;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: var(--text-3);
      @media (width < 30rem) {
        font-size: 0.5625rem;
      }
    }

    .portfolio-explorer_description {
      min-height: 4.25rem;
      margin-top: 1rem;
      font-size: 0.875rem;
      line-height: 1.65;
      color: var(--text-2);
      @media (width < 64rem) {
        min-height: 0;
        max-width: 34.375rem;
        font-size: 0.9375rem;
      }
      @media (width < 30rem) {
        margin-top: 0.875rem;
        font-size: 0.875rem;
        line-height: 1.6;
      }
    }

    .portfolio-explorer_metrics {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-block: 1.625rem;
      padding-bottom: 1.5rem;
      border-bottom: var(--border-width) solid var(--border);
      & > div {
        display: flex;
        flex-direction: column-reverse;
        justify-content: flex-end;
        gap: 0.5rem;
      }
      & dt {
        font-size: 0.75rem;
        color: var(--text-3);
      }
      & dd {
        margin: 0;
        font-size: 2.25rem;
        line-height: 1.15;
        letter-spacing: -0.09375rem;
        & span {
          margin-left: 0.4375rem;
          font-size: 0.8125rem;
          letter-spacing: var(--letter-spacing-normal);
        }
      }
      @media (width < 64rem) {
        max-width: 31.25rem;
      }
      @media (width < 30rem) {
        margin-block: 1.5rem;
        padding-bottom: 1.375rem;
        & dt {
          font-size: 0.6875rem;
        }
        & dd {
          font-size: 2.125rem;
          & span {
            font-size: 0.75rem;
          }
        }
      }
    }

    .portfolio-explorer_status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      &::before {
        content: "";
        flex-shrink: 0;
        width: 0.375rem;
        height: 0.375rem;
        border-radius: 50%;
        background-color: #a38a4c;
      }
      &.is-operational::before {
        background-color: var(--accent-500);
      }
      @media (width < 64rem) {
        font-size: 0.8125rem;
      }
      @media (width < 30rem) {
        gap: 0.4375rem;
        font-size: 0.75rem;
      }
    }

    .portfolio-explorer_status-note {
      min-height: 3.3125rem;
      margin: 0.625rem 0 1.375rem;
      font-size: 0.6875rem;
      line-height: 1.6;
      color: var(--text-3);
      @media (width < 64rem) {
        min-height: 0;
        max-width: 32.5rem;
        font-size: 0.75rem;
      }
      @media (width < 30rem) {
        font-size: 0.6875rem;
        line-height: 1.65;
      }
    }

    .portfolio-explorer_equipment > p {
      margin-top: 0.375rem;
      font-size: 0.8125rem;
      color: var(--text-2);
      @media (width < 64rem) {
        font-size: 0.875rem;
      }
      @media (width < 30rem) {
        font-size: 0.75rem;
      }
    }
  }
</style>
