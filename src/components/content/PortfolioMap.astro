---
import type { HTMLAttributes } from "astro/types";
import type { PortfolioAsset, PortfolioLocation } from "@/data/portfolio.ts";
import { uid } from "@/utils/unique-id.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Pins on the map. */
  locations?: PortfolioLocation[];
  /** Assets in tab order. A pin opens the first asset at its location. */
  assets?: PortfolioAsset[];
  /** Location key to highlight. */
  active?: string;
  /** Summary beside the label. */
  summary?: string;
  /** Note beside the legend. */
  note?: string;
};

const {
  render = true,
  locations = [],
  assets = [],
  active,
  summary,
  note,
  class: className,
  ...rest
} = Astro.props;

const id = uid("portfolio-map");
const dotsId = `${id}-dots`;
const titleId = `${id}-title`;
---

{
  render && locations.length > 0 && (
    <div class:list={["portfolio-map_wrap", className]} {...rest}>
      <div class="portfolio-map_bar">
        {summary && <span class="portfolio-map_summary">{summary}</span>}
      </div>
      <div class="portfolio-map_canvas">
        <svg
          class="portfolio-map_country"
          viewBox="0 0 760 490"
          role="img"
          aria-labelledby={titleId}
        >
          <title id={titleId}>
            Indicative locations of Slivnitsa, Bansko and Kableshkovo in
            Bulgaria
          </title>
          <defs>
            <pattern
              id={dotsId}
              width="9"
              height="9"
              patternUnits="userSpaceOnUse"
            >
              <circle cx="1" cy="1" r=".9" fill="#c4c8b9" />
            </pattern>
          </defs>
          <g transform="translate(0 29)">
            <path
              class="portfolio-map_outline"
              d="M78 11 L88 12 106 24 120 28 120 36 105 43 101 56 110 64 125 68 150 60 166 59 181 67 194 65 207 71 225 76 240 82 253 80 266 72 280 72 296 79 319 78 330 76 339 82 350 80 368 91 380 89 393 83 404 82 419 71 432 55 447 44 461 39 477 34 508 31 528 23 550 21 560 23 571 25 584 37 595 36 610 35 619 46 630 43 640 39 646 59 659 65 677 72 697 77 710 77 710 94 714 104 705 118 696 127 684 122 669 123 659 131 650 149 640 152 643 160 639 175 637 192 640 214 637 220 621 218 618 229 608 234 611 241 595 242 591 252 607 254 613 259 613 267 621 269 623 281 617 286 637 303 650 317 638 320 627 318 620 323 609 321 600 329 589 321 582 312 571 304 561 308 550 303 540 315 523 319 509 321 500 326 498 337 485 341 474 349 474 355 463 354 450 352 442 357 444 363 454 370 453 378 458 383 454 389 457 396 449 407 439 406 424 412 412 408 402 413 389 412 380 417 368 421 357 421 342 408 326 400 314 397 307 406 300 396 288 394 281 379 272 382 264 379 252 382 242 378 232 384 232 391 218 388 211 395 200 394 185 401 170 398 155 399 144 404 138 411 111 408 112 395 110 384 112 367 119 356 116 350 110 346 105 332 102 320 88 312 73 305 63 293 49 276 59 270 60 263 66 260 69 249 57 240 57 232 62 220 57 207 62 199 73 193 81 196 92 189 94 180 107 166 116 158 114 152 105 150 96 132 88 127 79 124 66 115 62 104 59 89 53 85 48 70 49 59 52 48 53 39 68 36 76 29 75 20 Z"
            />
            <path
              class="portfolio-map_dots"
              fill={`url(#${dotsId})`}
              d="M78 11 L120 28 101 56 125 68 166 59 207 71 240 82 280 72 330 76 368 91 404 82 447 44 508 31 550 21 584 37 610 35 619 46 640 39 646 59 677 72 710 77 714 104 696 127 669 123 650 149 637 192 640 214 618 229 595 242 591 252 613 259 623 281 617 286 650 317 620 323 600 329 571 304 550 303 540 315 509 321 498 337 474 349 450 352 442 357 454 370 458 383 457 396 449 407 424 412 402 413 368 421 357 421 326 400 307 406 288 394 281 379 252 382 242 378 232 391 218 388 200 394 185 401 155 399 138 411 111 408 110 384 112 367 119 356 105 332 102 320 73 305 49 276 69 249 57 240 62 220 57 207 73 193 81 196 94 180 116 158 114 152 105 150 96 132 66 115 59 89 48 70 53 39 68 36 76 29 Z"
            />
            <g class="portfolio-map_context" aria-hidden="true">
              <text
                class="portfolio-map_country-name"
                x="381"
                y="221"
                text-anchor="middle"
              >
                B U L G A R I A
              </text>
              <circle cx="177" cy="240" r="3" />
              <text class="portfolio-map_city" x="186" y="246">
                Sofia
              </text>
              <text class="portfolio-map_sea" x="688" y="242">
                BLACK
              </text>
              <text class="portfolio-map_sea" x="696" y="259">
                SEA
              </text>
            </g>
          </g>
        </svg>
        {locations.map((location) => {
          const here = assets.filter((asset) => asset.location === location.id);
          const tab = assets.findIndex(
            (asset) => asset.location === location.id,
          );
          const isActive = location.id === active;
          const isOperational = here.every((asset) => asset.operational);
          const status = isOperational ? "Operational" : "Commissioned";
          return (
            <button
              class:list={[
                "portfolio-map_pin",
                location.labelLeft && "is-left",
                isActive && "is-active",
                isOperational && "is-operational",
              ]}
              type="button"
              style={`left: ${location.x}%; top: ${location.y}%;`}
              data-tab={tab}
              aria-label={`Explore ${location.label} ${here.length > 1 ? "assets" : "asset"}, ${status.toLowerCase()}`}
              aria-pressed={isActive ? "true" : "false"}
            >
              <span class="portfolio-map_dot" />
              <span class="portfolio-map_pin-label">
                {location.label}
                <small>
                  {location.note ? `${location.note} · ${status}` : status}
                </small>
              </span>
            </button>
          );
        })}
      </div>
      <div class="portfolio-map_bar is-bottom">
        <span class="portfolio-map_keys">
          <span class="portfolio-map_key is-operational">Operational</span>
          <span class="portfolio-map_key">Commissioned</span>
        </span>
        {note && <span class="portfolio-map_note">{note}</span>}
      </div>
    </div>
  )
}

<script>
  for (const pin of document.querySelectorAll<HTMLButtonElement>(
    ".portfolio-map_pin",
  )) {
    pin.addEventListener("click", () => {
      const links = pin
        .closest(".tabs_wrap")
        ?.querySelectorAll<HTMLButtonElement>(".tabs_link");
      links?.[Number(pin.dataset.tab)]?.click();
    });
  }
</script>

<style is:global>
  @layer components {
    .portfolio-map_wrap {
      --portfolio-commissioned: #a38a4c;
      width: 100%;
      display: flex;
      flex-direction: column;
      min-width: 0;
      height: 100%;
      padding: 1.875rem 1.6875rem 1.5rem;
      @media (width < 64rem) {
        padding: 1.75rem 1.25rem;
      }
      @media (width < 30rem) {
        padding: 1.375rem 0.75rem 1.125rem;
        overflow: hidden;
      }
    }

    .portfolio-map_bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      font-size: 0.6875rem;
      color: var(--text-3);
      &.is-bottom {
        padding-top: 1.5rem;
        font-size: 0.625rem;
      }
      @media (width < 30rem) {
        gap: 0.5rem;
        font-size: 0.5625rem;
        &.is-bottom {
          padding-top: 1.25rem;
          font-size: 0.5625rem;
        }
      }
    }

    .portfolio-map_keys {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
    }

    .portfolio-map_summary {
      margin-left: auto;
    }

    .portfolio-map_key {
      display: flex;
      align-items: center;
      gap: 0.4375rem;
      &::before {
        content: "";
        width: 0.4375rem;
        height: 0.4375rem;
        border-radius: 50%;
        background-color: var(--portfolio-commissioned);
      }
      &.is-operational::before {
        background-color: var(--accent-500);
      }
    }

    .portfolio-map_note {
      @media (width < 30rem) {
        display: none;
      }
    }

    .portfolio-map_canvas {
      position: relative;
      width: 100%;
      aspect-ratio: 760 / 490;
      margin-block: auto;
      @media (width < 64rem) {
        margin-top: 1.5rem;
      }
      @media (width < 30rem) {
        margin-top: 2rem;
      }
    }

    .portfolio-map_country {
      width: 100%;
      height: auto;
      overflow: visible;
    }

    .portfolio-map_outline {
      fill: var(--light-200);
      stroke: #d2cdc5;
      stroke-width: 1.5;
      vector-effect: non-scaling-stroke;
    }

    .portfolio-map_dots {
      opacity: 0.5;
    }

    .portfolio-map_context {
      font-size: 12px;
      fill: #8b867e;
      & path {
        stroke: #a39e94;
      }
      @media (width < 30rem) {
        font-size: 17px;
      }
    }

    .portfolio-map_country-name {
      font-size: 15px;
      fill: #918c82;
      @media (width < 30rem) {
        font-size: 18px;
      }
    }

    .portfolio-map_sea {
      font-size: 10px;
      letter-spacing: 1.2px;
      @media (width < 30rem) {
        font-size: 13px;
      }
    }

    .portfolio-map_pin {
      position: absolute;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.8125rem;
      transform: translate(-50%, -50%);
      @media (width < 30rem) {
        padding: 1rem;
      }
    }

    .portfolio-map_dot {
      position: relative;
      width: 0.75rem;
      height: 0.75rem;
      border-radius: 50%;
      background-color: var(--portfolio-commissioned);
      border: 0.1875rem solid var(--light-200);
      .is-operational > & {
        background-color: var(--accent-500);
      }
      box-shadow: 0 0 0 var(--border-width) #718573;
      transition: box-shadow var(--hover-duration) var(--hover-ease);
      .is-active > & {
        box-shadow:
          0 0 0 0.4375rem rgb(0 140 68 / 0.08),
          0 0 0 0.875rem rgb(0 140 68 / 0.035);
      }
      @media (width < 30rem) {
        width: 0.625rem;
        height: 0.625rem;
        border-width: 0.125rem;
      }
    }

    .portfolio-map_pin-label {
      position: absolute;
      left: 2.25rem;
      padding: 0.4375rem 0.5625rem;
      font-size: 0.6875rem;
      font-weight: var(--primary-medium);
      line-height: 1.2;
      white-space: nowrap;
      text-align: left;
      color: var(--text-2);
      background-color: rgb(251 250 249 / 0.91);
      border: var(--border-width) solid rgb(231 228 224 / 0.5);
      border-radius: 0.375rem;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      & small {
        display: block;
        margin-top: 0.3125rem;
        font-size: 0.5625rem;
        font-weight: var(--primary-regular);
        color: var(--text-3);
      }
      .is-left > & {
        left: auto;
        right: 2.25rem;
      }
      .is-active > & {
        background-color: var(--brand-500);
        border-color: var(--brand-500);
        color: var(--light-200);
        & small {
          color: #bbd7c5;
        }
      }
      @media (width < 64rem) {
        font-size: 0.75rem;
      }
      @media (width < 30rem) {
        left: 2.125rem;
        padding: 0.375rem;
        font-size: 0.5625rem;
        border-radius: 0.25rem;
        .is-left > & {
          right: 2.125rem;
        }
        & small {
          margin-top: 0.1875rem;
          font-size: 0.5rem;
        }
      }
    }
  }
</style>
