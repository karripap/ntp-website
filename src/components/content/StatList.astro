---
import type { HTMLAttributes } from "astro/types";

type Stat = {
  /** The figure, e.g. `40`. */
  value: string;
  /** Unit set small beside the figure, e.g. `MW`. */
  unit?: string;
  /** Caption under the figure. */
  label: string;
};

type Props = HTMLAttributes<"dl"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Figures to list, in order. */
  items?: Stat[];
};

const { render = true, items = [], class: className, ...rest } = Astro.props;
---

{
  render && items.length > 0 && (
    <dl class:list={["stat-list_wrap", className]} {...rest}>
      {items.map((item) => (
        <div class="stat-list_item">
          <dt class="stat-list_label">{item.label}</dt>
          <dd class="stat-list_value">
            {item.value}
            {item.unit && <small class="stat-list_unit">{item.unit}</small>}
          </dd>
        </div>
      ))}
    </dl>
  )
}

<style is:global>
  @layer components {
    .stat-list_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      @media (width < 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: var(--space-5);
      }
    }

    .stat-list_item {
      display: flex;
      flex-direction: column-reverse;
      justify-content: flex-end;
      align-items: center;
      gap: var(--space-4);
      padding-inline: 1rem;
      text-align: center;
      & + & {
        border-left: var(--border-width) solid var(--border);
      }
      @media (width < 48rem) {
        &:nth-child(odd) {
          border-left: 0;
        }
        &:nth-child(n + 3) {
          padding-top: var(--space-5);
          border-top: var(--border-width) solid var(--border);
        }
      }
    }

    .stat-list_value {
      margin: 0;
      font-family: var(--h2-font-family);
      font-size: var(--h2);
      font-weight: var(--h2-font-weight);
      line-height: 1;
      letter-spacing: var(--h2-letter-spacing);
    }

    .stat-list_unit {
      margin-left: 0.25em;
      font-size: max(0.32em, 0.6875rem);
      letter-spacing: normal;
    }

    .stat-list_label {
      font-size: var(--text-small);
      line-height: var(--text-small-line-height);
      color: color-mix(in srgb, currentColor 70%, transparent);
    }
  }
</style>
