---
import Wordmark from "@/components/global/Wordmark.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <footer class="footer_wrap theme-dark">
      <div class="footer_inner">
        <div class="footer_top">
          <Wordmark label="NTP Consulting back to top" />
          <a class="footer_link" href="#">
            Back to top ↑
          </a>
        </div>
        <div class="footer_bottom">
          <span>
            <>
              <span>© </span>
              <span>2026</span>
              <span>&#160;</span>
            </>
            NTP Consulting OOD<span>. All Rights Reserved.</span>
          </span>
          <address>5 Oborishte Street · Sofia, Bulgaria</address>
        </div>
      </div>
    </footer>
  )
}

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding: 2.75rem var(--site-margin) 1.75rem;
      background-color: var(--brand-700);
      color: var(--text);
      @media (width < 30rem) {
        padding-block: 2.25rem 1.625rem;
      }
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-small);
      display: flex;
      flex-direction: column;
    }

    .footer_top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.875rem;
      padding-bottom: 2.25rem;
      border-bottom: var(--border-width) solid var(--border);
      font-size: 0.75rem;
      @media (width < 64rem) {
        font-size: 0.625rem;
      }
      @media (width < 30rem) {
        flex-wrap: wrap;
        gap: 1.5625rem;
        padding-bottom: 1.625rem;
      }
    }

    .footer_summary {
      color: var(--text-2);
      @media (width < 30rem) {
        order: 3;
        width: 100%;
        font-size: 0.6875rem;
      }
    }

    .footer_link {
      color: var(--text-2);
      font-size: 0.75rem;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
      @media (width < 30rem) {
        margin-left: auto;
        font-size: 0.625rem;
      }
    }

    .footer_bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding-top: 1.5rem;
      font-size: 0.625rem;
      color: var(--text-3);
      & address {
        font-style: normal;
      }
      @media (width < 64rem) {
        flex-wrap: wrap;
        gap: 0.9375rem;
      }
      @media (width < 30rem) {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.625rem;
        line-height: 1.6;
      }
    }

    .footer_slogan {
      text-align: right;
      @media (width < 64rem) {
        display: none;
      }
    }
  }
</style>
