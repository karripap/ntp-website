---
import NavLink from "@/components/global/NavLink.astro";
import Wordmark from "@/components/global/Wordmark.astro";
import Button from "@/components/Button.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Lay the nav over the first section rather than above it. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

const home = Astro.url.pathname === "/" ? "" : "/";
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_progress" aria-hidden="true" />
      <div class="nav_inner">
        <Wordmark href={home || "#"} />
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <ul class="nav_links">
            <NavLink href={`${home}#portfolio`}>
              The portfolio <span class="nav_index">01</span>
            </NavLink>
            <NavLink href={`${home}#capacity`}>
              The capacity <span class="nav_index">02</span>
            </NavLink>
            <NavLink href={`${home}#technology`}>
              The technology <span class="nav_index">03</span>
            </NavLink>
            <li class="nav_menu_contact">
              <a class="nav_link" href={`${home}#contact`}>
                Let’s talk <span class="nav_index">↗</span>
              </a>
            </li>
          </ul>
        </nav>
        <span class="nav_cta">
          <Button element="link" href={`${home}#contact`} trail="↗">
            Let’s talk
          </Button>
        </span>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_bar" />
          <span class="nav_toggle_bar" />
        </button>
      </div>
    </header>
  )
}

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  const progress = nav?.querySelector<HTMLElement>(".nav_progress");

  if (nav && toggle) {
    nav.classList.add("is-scripted");

    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open ? "Close navigation" : "Open navigation",
      );
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll(".nav_menu a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 64rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });

    const links = [
      ...nav.querySelectorAll<HTMLAnchorElement>(".nav_links .nav_link"),
    ];
    const sections = links
      .map((link) => document.getElementById(link.hash.slice(1)))
      .filter((section): section is HTMLElement => !!section);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            link.classList.toggle(
              "is-current",
              link.hash === `#${entry.target.id}`,
            );
          }
        }
      },
      { rootMargin: "-15% 0px -65% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }

  if (progress) {
    let queued = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      progress.style.setProperty(
        "--_progress",
        String(max > 0 ? scrollY / max : 0),
      );
      queued = false;
    };
    addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width) solid var(--border);

      &.overlap {
        position: absolute;
        inset: 1.625rem 0 auto;
        background-color: transparent;
        color: var(--light-200);
        border-bottom: 0;
        @media (width < 64rem) {
          top: 1.125rem;
        }
        @media (width < 30rem) {
          top: 0.9375rem;
        }
      }
    }

    .nav_progress {
      position: fixed;
      inset: 0 0 auto;
      height: 0.125rem;
      background-color: var(--accent-500);
      transform: scaleX(var(--_progress, 0));
      transform-origin: left;
      pointer-events: none;
      z-index: 150;
    }

    .nav_inner {
      position: relative;
      width: 100%;
      max-width: var(--max-width-main);
      min-height: var(--nav-height);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.75rem;
      @media (width < 64rem) {
        gap: 0.75rem;
      }
    }

    .nav_links {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      font-size: 0.875rem;
      font-weight: var(--primary-medium);
    }

    .nav_link {
      position: relative;
      display: block;
      padding-block: 0.625rem;
      opacity: 0.88;
      transition: opacity var(--hover-duration) var(--hover-ease);
      &::after {
        content: "";
        position: absolute;
        inset: auto 0 0.25rem;
        height: var(--border-width);
        background-color: currentcolor;
        transform: scaleX(0);
        transition: transform var(--hover-duration) var(--hover-ease);
      }
      &.is-current {
        opacity: 1;
        &::after {
          transform: scaleX(1);
        }
      }
      @media (hover: hover) {
        &:hover {
          opacity: 1;
          &::after {
            transform: scaleX(1);
          }
        }
      }
    }

    .nav_index,
    .nav_menu_contact {
      display: none;
    }

    .nav_toggle {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.3125rem;
      width: 1.875rem;
      height: 2.5rem;
      color: inherit;
    }

    .nav_toggle_bar {
      width: 1.375rem;
      height: var(--border-width);
      background-color: currentcolor;
      transition: transform var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_toggle_bar {
      &:first-child {
        transform: translateY(0.1875rem) rotate(45deg);
      }
      &:last-child {
        transform: translateY(-0.1875rem) rotate(-45deg);
      }
    }

    @media (width < 64rem) {
      .nav_wrap.is-scripted .nav_toggle {
        display: flex;
      }

      .nav_wrap.is-scripted .nav_menu {
        display: none;
      }

      .nav_cta {
        margin-left: auto;
      }

      .nav_wrap.open .nav_menu {
        display: block;
        position: absolute;
        top: 4.5rem;
        inset-inline: -1rem;
        padding: 1rem 1.5rem 1.5rem;
        background-color: var(--light-200);
        color: var(--dark-800);
        border: var(--border-width) solid var(--light-500);
        border-radius: 1rem;
        box-shadow: 0 0.75rem 2.1875rem rgb(0 0 0 / 0.13);
      }

      .nav_links {
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        font-size: 1.3125rem;
        font-weight: var(--primary-regular);
        letter-spacing: -0.025em;
      }

      .nav_menu_contact {
        display: block;
      }

      .nav_link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-block: 1rem;
        opacity: 1;
        border-bottom: var(--border-width) solid var(--light-500);
        &::after {
          display: none;
        }
      }

      .nav_index {
        display: inline;
        font-size: 0.75rem;
        letter-spacing: var(--letter-spacing-normal);
        color: var(--dark-500);
      }
    }

    @media (width < 30rem) {
      .nav_cta {
        display: none;
      }

      .nav_toggle {
        margin-left: auto;
      }
    }
  }
</style>
