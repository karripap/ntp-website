---
import type { HTMLAttributes } from "astro/types";
import Logo from "@/assets/logo/ntp-logo.svg";

type Props = HTMLAttributes<"a"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Link destination. */
  href?: string;
  /** Accessible label. */
  label?: string;
};

const {
  render = true,
  href = "#",
  label = "NTP Consulting home",
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (
    <a
      class:list={["wordmark_wrap", className]}
      href={href}
      aria-label={label}
      {...rest}
    >
      <Logo class="wordmark_logo" aria-hidden="true" />
    </a>
  )
}

<style is:global>
  @layer components {
    .wordmark_wrap {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      color: inherit;
      text-decoration: none;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.8;
        }
      }
    }

    .wordmark_logo {
      width: auto;
      height: 2.25rem;
      & :is(path, rect) {
        fill: currentcolor;
      }
      @media (width < 30rem) {
        height: 2rem;
      }
    }
  }
</style>
