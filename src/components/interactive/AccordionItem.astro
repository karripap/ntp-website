---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow.svg";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"details"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Item heading. */
  heading?: string;
  /** Heading level. */
  headingTag?: "h2" | "h3" | "h4" | "h5" | "h6";
  /** Open on load. */
  open?: boolean;
  /** Item style. */
  variant?: "default" | "card";
  /** Number shown before the heading. */
  index?: string;
};

const {
  render = true,
  heading,
  headingTag = "h3",
  open = false,
  variant = "default",
  index,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && heading && content && (
    <details
      class:list={[
        "accordion_item",
        variant !== "default" && variant,
        className,
      ]}
      open={open}
      data-accordion-group
      {...rest}
    >
      <summary class="accordion_toggle">
        <span class="accordion_label">
          {index && <span class="accordion_index">{index}</span>}
          <Heading
            tag={headingTag}
            variant={variant === "card" ? "h6" : "h5"}
            class="accordion_title"
          >
            {heading}
          </Heading>
        </span>
        {variant === "card" ? (
          <span class="accordion_plus" aria-hidden="true" />
        ) : (
          <Icon class="accordion_icon" src={arrow} variant="small" />
        )}
      </summary>

      <div class="accordion_body margin-trim">
        <Fragment set:html={content} />
      </div>
    </details>
  )
}

<style is:global>
  @layer components {
    .accordion_item {
      interpolate-size: allow-keywords;
      border-bottom: var(--border-width) solid var(--border);
      transition: border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-bottom-color: currentcolor;
        }
      }
    }

    .accordion_toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-block: var(--space-5);
      list-style: none;
      cursor: pointer;
      &::-webkit-details-marker {
        display: none;
      }
    }

    .accordion_title {
      margin-block: 0;
    }

    .accordion_label {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      @media (width < 30rem) {
        gap: 0.625rem;
      }
    }

    .accordion_index {
      min-width: 1rem;
      font-size: 0.6875rem;
      color: var(--text-3);
    }

    .accordion_plus {
      position: relative;
      flex-shrink: 0;
      width: 0.75rem;
      height: 0.75rem;
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset: 50% 0 auto;
        height: var(--border-width);
        background-color: currentcolor;
      }
      &::after {
        rotate: 90deg;
        transition: rotate var(--open-duration) var(--open-ease);
      }
    }

    .accordion_item:is([open], .stacki-opened) .accordion_plus::after,
    .stacki-designer .accordion_wrap.preview .accordion_plus::after {
      rotate: 0deg;
    }

    .accordion_item.card {
      padding-inline: 1.4375rem;
      background-color: var(--light-100);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-medium);
      @media (hover: hover) {
        &:hover {
          border-color: var(--border);
        }
      }
      & + .card {
        margin-top: 0.75rem;
      }
      & .accordion_toggle {
        gap: 1.125rem;
        padding-block: 1.75rem;
      }
      & .accordion_body {
        padding: 0.25rem 0 1.4375rem 1.875rem;
        font-size: 0.875rem;
        line-height: 1.65;
        color: var(--text-2);
      }
      @media (width < 30rem) {
        padding-inline: 1.125rem;
        & .accordion_toggle {
          gap: 0.75rem;
          padding-block: 1.5rem;
        }
        & .accordion_body {
          padding: 0 0 1.25rem;
          font-size: 0.8125rem;
        }
      }
    }

    .accordion_icon {
      rotate: 90deg;
      transition: rotate var(--open-duration) var(--open-ease);
    }

    .accordion_item:is([open], .stacki-opened) .accordion_icon,
    .stacki-designer .accordion_wrap.preview .accordion_icon {
      rotate: -90deg;
    }

    .accordion_item::details-content {
      block-size: 0;
      overflow: hidden;
      content-visibility: hidden;
      transition:
        block-size var(--open-duration) var(--open-ease),
        content-visibility var(--open-duration) var(--open-ease) allow-discrete;
    }

    .accordion_item:is([open], .stacki-opened)::details-content,
    .stacki-designer .accordion_wrap.preview .accordion_item::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    .accordion_body {
      padding-bottom: var(--space-5);
    }
  }
</style>
