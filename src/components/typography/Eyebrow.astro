---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      <Tag class="eyebrow_text">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);
      color: var(--text-3);

      &.tag {
        background-color: var(--brand-100);
        color: var(--brand-500);
        padding: 0.3125rem 0.5rem;
        border-radius: 0.25rem;
      }
      .eyebrow_text {
        font-size: 0.6875rem;
        font-weight: var(--primary-medium);
        line-height: 1.45;
        letter-spacing: var(--letter-spacing-wide);
        text-transform: uppercase;
        @media (width < 30rem) {
          font-size: 0.625rem;
        }
      }
    }
  }
</style>
