---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import Overlay from "@/components/media/Overlay.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import PortfolioExplorer from "@/components/content/PortfolioExplorer.astro";
import CapacityCalculator from "@/components/content/CapacityCalculator.astro";
import TechnologyDrawing from "@/components/content/TechnologyDrawing.astro";
import SpecList from "@/components/content/SpecList.astro";
import StatList from "@/components/content/StatList.astro";
import battery_landscape from "@/assets/images/battery-landscape.png";
import { PORTFOLIO_ASSETS, PORTFOLIO_LOCATIONS } from "@/data/portfolio.ts";
import { CONTACT_EMAIL, SITE_NAME } from "@/consts.ts";
import { homeSchema } from "@/data/schema.ts";
import JsonLd from "@/components/utility/JsonLd.astro";

const title = "160 MWh Battery Portfolio in Bulgaria";
const description =
  "Four grid-connected battery storage sites across three regions of Bulgaria: 40 MW of combined power and 160 MWh of capacity. Explore the NTP Consulting portfolio.";

const mailto = (subject: string) =>
  `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`;
---

<Layout
  title={title}
  description={description}
  overlap={true}
>
  <JsonLd
    slot="head"
    data={homeSchema({ title: `${SITE_NAME} | ${title}`, description })}
  />

  <!-- hero -->
  <Section
    theme="dark"
    paddingTop="navoverlap"
    class="justify-content-end overflow-clip min-height-screen"
    aria-label="Introduction"
    paddingBottom="large"
  >
    <Img
      slot="background"
      src={battery_landscape}
      alt="Concept visualisation of a battery storage facility in a Bulgarian countryside setting"
      loading="eager"
      fetchPriority="high"
      style="object-position: 65% center;"
      class="parallax-bg"
    />
    <Overlay slot="background" variant="gradient" strength={55} />
    <ContentWrapper class="parallax-drift">
      <Heading variant="display" maxWidth={16} tag="h1"
        >160 MWh battery portfolio<br /> in Bulgaria</Heading
      >
      <Paragraph variant="large" maxWidth={36}
        >Four grid-connected battery sites with 40 MW of combined power</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href="#portfolio" trail="→"
          >Explore the portfolio</Button
        >
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- at a glance -->
  <Section
    paddingTop="small"
    paddingBottom="small"
    containerClass="max-width-small"
    aria-label="Portfolio at a glance"
    class="background-2"
  >
    <StatList
      items={[
        { value: "40", unit: "MW", label: "Aggregate power" },
        { value: "160", unit: "MWh", label: "Storage capacity" },
        { value: "4", unit: "hours", label: "Nominal duration at rated power" },
        { value: "04", unit: "assets", label: "One Bulgarian portfolio" },
      ]}
    />
  </Section>

  <!-- portfolio -->
  <Section id="portfolio" aria-labelledby="portfolio-title" paddingTop="small" paddingBottom="small">
    <ContentWrapper centered={true}>
      <Eyebrow>01 / The portfolio</Eyebrow>
      <Heading id="portfolio-title" variant="h1"
        >Four sites in three<br /> regions of Bulgaria</Heading
      >
      <Paragraph class="color-faded" maxWidth={64}
        >Spreading the capacity across the west, the southwest and the east
        means each site connects to a different part of the grid, so a fault in
        one area doesn’t stop the whole portfolio.</Paragraph
      >
    </ContentWrapper>
    <PortfolioExplorer
      assets={PORTFOLIO_ASSETS}
      locations={PORTFOLIO_LOCATIONS}
      mapSummary="3 locations / 4 assets"
      class="parallax-float"
    />
  </Section>

  <!-- capacity -->
  <Section
    id="capacity"
    class="background-2"
    aria-labelledby="capacity-title"
    paddingTop="small"
    paddingBottom="small"
  >
    <ContentWrapper variant="columns">
      <Eyebrow>02 / The capacity</Eyebrow>
      <Heading id="capacity-title" variant="h1"
        >Why invest in<br /> battery storage<br /> in Bulgaria</Heading
      >
      <Paragraph variant="large" class="color-faded" maxWidth={44}
        >160 MWh is more than a number. It is power with time on its side. At
        the portfolio’s rated 40 MW, that means four hours of nominal storage.
        Explore how the same energy capacity translates at a lower output.</Paragraph
      >
      <CapacityCalculator slot="column2" class="theme-brand parallax-float" />
    </ContentWrapper>
  </Section>

  <!-- technology -->
  <Section id="technology" aria-labelledby="technology-title" paddingTop="small" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow>03 / The technology</Eyebrow>
      <Heading id="technology-title">Serious infrastructure</Heading>
    </ContentWrapper>
    <ContentWrapper
      variant="sticky-content"
      class="gap-small"
      column2Class="align-self-start"
    >
      <TechnologyDrawing tag="0.25C" model="CRRC CESS-L5016-0.25C" class="parallax-float" />
      <Accordion slot="column2" single={false} openFirst={true}>
        <AccordionItem
          variant="card"
          index="01"
          heading="Liquid-cooled battery storage"
        >
          <Paragraph
            >CRRC CESS-L5016-0.25C centralized energy storage systems form the
            battery foundation across the portfolio.</Paragraph
          >
          <SpecList
            items={[
              { label: "Manufacturer", value: "CRRC Corporation Ltd." },
              { label: "System type", value: "Centralized, liquid-cooled" },
            ]}
          />
        </AccordionItem>
        <AccordionItem variant="card" index="02" heading="Power conversion">
          <Paragraph
            >Power conversion systems manage the exchange of electricity between
            the batteries and the AC system.</Paragraph
          >
          <SpecList
            items={[
              { label: "Bansko 1", value: "2 × CRRC e-Station-5000" },
              { label: "Bansko 2", value: "1 × CRRC e-Station-10000" },
              { label: "Kableshkovo", value: "8 × Sineng EH-1250-HB-UD" },
              { label: "Slivnitsa", value: "2 × CRRC e-Station-5000" },
            ]}
          />
        </AccordionItem>
        <AccordionItem
          variant="card"
          index="03"
          heading="Commissioning & milestones"
        >
          <Paragraph
            >All four assets are reported to have completed the mandatory
            72-hour commissioning tests.</Paragraph
          >
          <SpecList
            items={[
              { label: "Kableshkovo", value: "Commercial operation achieved" },
            ]}
          />
          <Paragraph
            >Bansko 1, Bansko 2 and Slivnitsa had a scheduled commercial
            operation date of 15 August 2026 in the supplied overview. Their
            current commercial status requires confirmation.</Paragraph
          >
          <ButtonWrapper marginTop="4">
            <Button
              element="link"
              variant="link"
              href={mailto("NTP portfolio | Latest project milestones")}
              trail="↗"
            >
              Request the latest milestones
            </Button>
          </ButtonWrapper>
        </AccordionItem>
      </Accordion>
    </ContentWrapper>
  </Section>

  <!-- perspective -->
  <Section
    paddingTop="none"
    paddingBottom="none"
    aria-label="Energy perspective"
  >
    <ContentWrapper variant="card" class="theme-brand parallax-zoom">
      <Eyebrow>Made for a more flexible grid</Eyebrow>
      <Paragraph variant="display" class="margin-top-5"
        >Invest in the<br /> future of energy</Paragraph
      >
    </ContentWrapper>
  </Section>

  <!-- contact -->
  <Section
    id="contact"
    containerClass="max-width-small"
    aria-labelledby="contact-title"
  >
    <ContentWrapper variant="auto-width">
      <Heading id="contact-title" variant="display"
        >Let’s talk<br /> potential.</Heading
      >
      <Paragraph slot="column2" class="color-faded"
        >Explore the investment opportunity.<br />Get closer to the numbers.</Paragraph
      >
      <ButtonWrapper slot="column2" marginTop="4">
        <Button
          element="link"
          href={mailto("NTP | 160 MWh battery portfolio")}
          trail="↗">{CONTACT_EMAIL}</Button
        >
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
